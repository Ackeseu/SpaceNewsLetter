# Server Configuration
NODE_ENV=development
PORT=3000

# Azure Database for PostgreSQL
DB_HOST=your-server.postgres.database.azure.com
DB_PORT=5432
DB_NAME=newsletter_db
DB_USER=your-admin@your-server
DB_PASSWORD=your-password
DB_SSL=true
# Set to 'false' only when using Azure PostgreSQL with self-signed certificates
DB_SSL_REJECT_UNAUTHORIZED=true

# Azure Communication Services
AZURE_COMMUNICATION_CONNECTION_STRING=endpoint=https://your-acs.communication.azure.com/;accesskey=your-key
SENDER_EMAIL=donotreply@your-domain.com
SENDER_NAME=SEA NewSpace Summary

# NewsAPI (optional - for additional news sources)
NEWS_API_KEY=your-newsapi-key

# Application Settings
NEWSLETTER_FREQUENCY=weekly
MAX_ARTICLES_PER_NEWSLETTER=10

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com

# Security
JWT_SECRET=your-jwt-secret-key-here
