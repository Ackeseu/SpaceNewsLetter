{
  "name": "newspace-newsletter",
  "version": "1.0.0",
  "description": "NewSpace newsletter subscription service running on Azure",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "backfill:summaries": "ts-node backfill-summaries.ts",
    "backfill:title-images": "ts-node backfill-title-images.ts",
    "backfill:hk-focus": "ts-node backfill-hk-focus.ts"
  },
  "keywords": [
    "newsletter",
    "newspace",
    "azure",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@azure/communication-email": "^1.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/node-fetch": "^2.6.13",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "handlebars": "^4.7.8",
    "helmet": "^7.1.0",
    "node-cron": "^3.0.3",
    "node-fetch": "^2.7.0",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "rss-parser": "^3.13.0",
    "sequelize": "^6.35.0",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2"
  }
}
